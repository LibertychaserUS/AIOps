{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/schema/trace.schema.json",
  "title": "Overlay suites/<id>/trace.yaml",
  "description": "Optional machine trace from function_id × level to a case. Grammar is product-agnostic (LOGIN-01 and CHK-02 both match). Do not use REQ-n.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite", "items"],
  "properties": {
    "schema": { "const": "overlay-trace/v1" },
    "suite": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["function_id", "level", "case_id", "type"],
        "properties": {
          "function_id": {
            "type": "string",
            "pattern": "^[A-Z]{2,8}(-[A-Z]{1,6})?-[0-9]{2,3}$",
            "description": "Same id as the PRD function leaf. Level is a facet, not a second numbering system."
          },
          "level": {
            "enum": ["unit", "integration", "smoke", "k6", "e2e"],
            "description": "IEEE test level facet of the same function_id."
          },
          "case_id": {
            "type": "string",
            "minLength": 1,
            "description": "Optional instance: <function_id>/<level>/<seq>."
          },
          "type": {
            "enum": ["functional", "negative", "edge"],
            "description": "IEEE test technique, not a competing id."
          }
        }
      }
    }
  }
}
