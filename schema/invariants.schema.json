{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/schema/invariants.schema.json",
  "title": "Overlay invariants.yaml",
  "description": "Optional adopter ledger of system properties that need a cited case. Ids are free strings, not a required INV-/REQ-/IEEE series.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "overlay-invariants/v1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "function_ids"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S+$",
            "description": "Adopter-minted invariant id. Unique in the file. Not a required INV- prefix."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The property that must hold across leaves."
          },
          "function_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "description": "Leaves that jointly protect this property."
          },
          "span": {
            "enum": ["local", "interaction", "system"],
            "description": "How wide the property is. Default system when omitted."
          }
        }
      }
    }
  }
}
